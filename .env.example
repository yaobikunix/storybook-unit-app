# [環境変数の設定]
# MEMO: `NEXT_PUBLIC_`をつけるとブラウザに公開される

# MOCK API の有効設定 [enabled: 有効, disabled: 無効]
NEXT_PUBLIC_MOCK_API=enabled

# API Route の有効設定 [enabled: 有効, disabled: 無効]
NEXT_PUBLIC_API_ROUTE=disabled

# APIの参照先URL（環境ごとに設定: 本番は仮のURLです）
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:3000
NEXT_PUBLIC_PROD_API_URL=https://prod-www.storybook-app-api.net
