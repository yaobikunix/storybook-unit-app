# EditorConfig is awesome: https://editorconfig.org
root = true

# フロントエンドの設定
[*.{css,sass,html,ts,js,jsx,tsx}]
indent_style = space
indent_size = 2
tab_width = 2

# サーバーサイドの設定
[server/**/*.{ts,js}]
indent_style = space
indent_size = 4
tab_width = 4

# 一般的な設定
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
